---
const { headings } = Astro.props;
---
<aside data-article-index aria-label="Índice del artículo">
  <span class="eyebrow">EN ESTA ENTRADA</span>
  {headings.filter((heading:any)=>heading.depth===2).map((heading:any)=><a href={'#'+heading.slug}>{heading.text}</a>)}
</aside>
<script>
const index=document.querySelector<HTMLElement>('[data-article-index]');
if(index){
 const links=[...index.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
 const sections=links.flatMap(link=>{
  const heading=document.getElementById(decodeURIComponent(link.hash.slice(1)));
  return heading?[{link,heading}]:[];
 });
 let scheduled=false;
 let active='';
 let clickedTarget:HTMLElement|undefined;
 let releaseTimer=0;
 function update(){
  scheduled=false;
  if(clickedTarget){
   if(Math.abs(clickedTarget.getBoundingClientRect().top-30)>8)return;
   clickedTarget=undefined;clearTimeout(releaseTimer);
  }
  let current=sections.filter(section=>section.heading.getBoundingClientRect().top<=120).at(-1);
  // Keep the final section selected even if it is shorter than the viewport.
  if(scrollY>0&&innerHeight+scrollY>=document.documentElement.scrollHeight-4)current=sections.at(-1);
  const id=current?.heading.id||'';
  if(id===active)return;
  active=id;
  sections.forEach(({link,heading})=>{
   if(heading.id===id)link.setAttribute('aria-current','location');
   else link.removeAttribute('aria-current');
  });
  // replaceState updates the shareable anchor without adding history entries
  // or triggering another scroll. Keep query parameters intact.
  if(id){
   try{history.replaceState(history.state,'',location.pathname+location.search+'#'+encodeURIComponent(id));}catch{}
  }
 }
 function schedule(){if(!scheduled){scheduled=true;requestAnimationFrame(update)}}
 sections.forEach(({link,heading})=>link.addEventListener('click',event=>{
  if(event.button!==0||event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;
  clickedTarget=heading;clearTimeout(releaseTimer);
  // Let native anchor scrolling finish without replacing its destination
  // with intermediate sections on the way down.
  releaseTimer=window.setTimeout(()=>{clickedTarget=undefined;schedule()},1200);
 }));
 window.addEventListener('scroll',schedule,{passive:true});
 window.addEventListener('resize',schedule,{passive:true});
 window.addEventListener('pageshow',schedule);
 window.addEventListener('hashchange',schedule);
 update();
}
</script>
