---
const fragments=['const node = await scan();','0101 { port: 443 } 0010','ssh key => access();','function explore(host) {}','if (open) return service;','GET /notes HTTP/1.1','let findings = new Map();','[::] root@localhost ~ $'];
const streams=Array.from({length:22},(_,i)=>({text:(fragments[i%fragments.length]+' '+fragments[(i+3)%fragments.length]).split('').join('\n'),x:(i+.5)/22*100,duration:32+i%7*3,delay:-(i*7.3)%48}));
---
<div class="code-rain" aria-hidden="true">{streams.map(stream=><span class="rain-stream" style={`--x:${stream.x}%;--duration:${stream.duration}s;--delay:${stream.delay}s`}>{stream.text}</span>)}</div>
<style>
.code-rain{position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none;user-select:none;-webkit-mask-image:linear-gradient(90deg,#000,rgba(0,0,0,.28) 20%,rgba(0,0,0,.1) 48%,rgba(0,0,0,.3) 72%,#000);mask-image:linear-gradient(90deg,#000,rgba(0,0,0,.28) 20%,rgba(0,0,0,.1) 48%,rgba(0,0,0,.3) 72%,#000);transform:translateZ(0)}
.rain-stream{position:absolute;left:var(--x);top:-900px;white-space:pre;font:10px/21px 'JetBrains Mono',monospace;color:#aaa7bf;opacity:.17;-webkit-mask-image:linear-gradient(transparent,rgba(0,0,0,.25) 35%,#000 95%,transparent);mask-image:linear-gradient(transparent,rgba(0,0,0,.25) 35%,#000 95%,transparent);animation:code-fall var(--duration) linear var(--delay) infinite;will-change:transform}
@keyframes code-fall{from{transform:translate3d(0,-20vh,0)}to{transform:translate3d(0,calc(100vh + 1400px),0)}}
@media(max-width:700px){.rain-stream{font-size:9px;opacity:.12}.rain-stream:nth-child(2n){display:none}.code-rain{-webkit-mask-image:linear-gradient(90deg,#000,rgba(0,0,0,.08) 45%,#000);mask-image:linear-gradient(90deg,#000,rgba(0,0,0,.08) 45%,#000)}}
@media(prefers-reduced-motion:reduce){.rain-stream{animation:none;transform:translateY(700px);opacity:.08;will-change:auto}}
:global(body){isolation:isolate}
:global(body:before){z-index:-2}
</style>
<script>
const rain=document.querySelector<HTMLElement>('.code-rain');
function pauseRain(){rain?.querySelectorAll<HTMLElement>('.rain-stream').forEach(stream=>stream.style.animationPlayState=document.hidden?'paused':'running')}
document.addEventListener('visibilitychange',pauseRain);window.addEventListener('pageshow',pauseRain);pauseRain();
</script>
