<script>
import { motionEnabled } from '../lib/motion-preference';
const blocks=[...document.querySelectorAll<HTMLElement>('[data-typewriter]')];
const timers=new Set<number>();
let observer:IntersectionObserver|undefined;
let pendingEntry=true;
function finish(){
 timers.forEach(timer=>clearTimeout(timer));timers.clear();observer?.disconnect();
 blocks.forEach(block=>{block.classList.remove('is-typing');block.querySelector('.is-current')?.classList.remove('is-current')});
 document.querySelectorAll('.reveal-ready').forEach(node=>node.classList.add('is-revealed'));
}
function type(block:HTMLElement){
 const chars=[...block.querySelectorAll<HTMLElement>('.type-char')];
 chars.forEach(char=>char.classList.remove('is-visible','is-current'));
 block.classList.add('is-typing');let index=0;
 const next=()=>{
  if(!motionEnabled()||document.hidden){pendingEntry=true;finish();return;}
  block.querySelector('.is-current')?.classList.remove('is-current');
  if(index>=chars.length){block.classList.remove('is-typing');return;}
  chars[index++].classList.add('is-visible','is-current');
  const timer=window.setTimeout(()=>{timers.delete(timer);next()},30);timers.add(timer);
 };next();
}
function start(){
 finish();if(!motionEnabled()||document.hidden){pendingEntry=true;return;}
 pendingEntry=false;
 blocks.forEach(type);
 // Never hide or transform a complete article: long blocks may never reach
 // an intersection ratio, and transformed parents break sticky navigation.
 const nodes=[...document.querySelectorAll<HTMLElement>('.solved-heading,.machine-card,.archive-top,.entry,.article-heading,.about h1,.hero .lead,.hero .explore,.prose h2')];
 if(!('IntersectionObserver' in window))return;
 observer=new IntersectionObserver(entries=>entries.forEach(entry=>{
  if(entry.isIntersecting){entry.target.classList.add('is-revealed');observer?.unobserve(entry.target)}
 }),{threshold:0,rootMargin:'0px 0px -24px 0px'});
 nodes.forEach((node,index)=>{
  // Content already reached by the reader stays visible, including on a
  // restored tab or a direct visit to an article anchor.
  const reached=node.getBoundingClientRect().top<window.innerHeight-24;
  node.classList.toggle('is-revealed',reached);
  node.classList.add('reveal-ready');
  node.style.setProperty('--reveal-delay',`${node.classList.contains('machine-card')?index%3*50:0}ms`);
 });
 // Safari necesita un estado inicial calculado antes de iniciar la transición.
 if(nodes.length)void nodes[0].offsetWidth;
 requestAnimationFrame(()=>{if(motionEnabled())nodes.forEach(node=>observer?.observe(node))});
}
const ready=document.fonts?.ready||Promise.resolve();
Promise.race([ready,new Promise<void>(resolve=>window.setTimeout(resolve,500))]).then(()=>{if(pendingEntry)start()});
window.addEventListener('bitacora:motionchange',start);
document.addEventListener('visibilitychange',()=>{if(document.hidden){pendingEntry=true;finish()}else if(pendingEntry)start()});
window.addEventListener('pagehide',finish);
window.addEventListener('pageshow',event=>{if(event.persisted)start()});
</script>
