---
import { withBase } from '../lib/paths.mjs';
const { posts } = Astro.props;
const solved = posts.filter((p:any)=>p.frontmatter.status==='resuelta');
---
{solved.length > 0 && <section class="solved shell" aria-label="Máquinas resueltas" aria-roledescription="carrusel">
  <div class="solved-heading"><div><p class="eyebrow">LA COLECCIÓN</p><h2>Máquinas resueltas</h2></div><div class="slider-controls"><button type="button" data-slide="prev" aria-label="Máquinas anteriores">←</button><button type="button" data-slide="next" aria-label="Máquinas siguientes">→</button></div></div>
  <div class="machine-track" tabindex="0" aria-label="Desliza para ver todas las máquinas">
    {solved.map(({frontmatter:m,icon}:any)=><article class="machine-card"><a class="machine-cover" href={withBase('/writeups/'+m.slug+'/')} aria-label={'Leer write-up de '+m.title}>{icon ? <img class="machine-emblem" src={icon} alt={'Logo de '+m.title} loading="lazy" width="140" height="140"/> : <span class="machine-emblem-fallback" aria-hidden="true">{m.os==='Linux'?'◈':'⊞'}</span>}<span class="cover-caption">Leer write-up ↗</span></a><div class="card-info"><a href={withBase('/writeups/'+m.slug+'/')}><h3>{m.title}</h3></a><span data-difficulty={m.difficulty}>{m.difficulty}</span><p>{m.platform} · {m.os}{m.demo && ' · Ejemplo'}</p>{m.machineUrl && <a class="platform-link" href={m.machineUrl} target="_blank" rel="noopener noreferrer">Ir a la máquina ↗</a>}</div></article>)}
  </div><p class="slider-status" aria-live="polite"></p>
</section>}
<script>
document.querySelectorAll<HTMLElement>('.solved').forEach(section=>{
 const track=section.querySelector<HTMLElement>('.machine-track')!;const prev=section.querySelector<HTMLButtonElement>('[data-slide="prev"]')!;const next=section.querySelector<HTMLButtonElement>('[data-slide="next"]')!;const cards=[...track.querySelectorAll<HTMLElement>('.machine-card')];
 const update=()=>{prev.disabled=track.scrollLeft<=2;next.disabled=track.scrollLeft+track.clientWidth>=track.scrollWidth-2;const index=Math.max(0,cards.findIndex(card=>card.offsetLeft+card.offsetWidth>track.scrollLeft+track.offsetLeft+5));section.querySelector('.slider-status')!.textContent=cards.length ? `${index+1} / ${cards.length} máquinas · Desliza para explorar` : 'Tu próxima máquina aparecerá aquí.'};
 function slide(direction:number){const width=cards[0]?.getBoundingClientRect().width||track.clientWidth;track.scrollBy({left:direction*(width+20),behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'})}prev.addEventListener('click',()=>slide(-1));next.addEventListener('click',()=>slide(1));track.addEventListener('scroll',update,{passive:true});track.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();slide(e.key==='ArrowRight'?1:-1)}});new ResizeObserver(update).observe(track);update();
});
</script>
