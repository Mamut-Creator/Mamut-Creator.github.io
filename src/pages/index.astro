---
import { withBase } from '../lib/paths.mjs';
import Layout from '../layouts/Layout.astro';
import Typewriter from '../components/Typewriter.astro';


import { posts } from '../lib/posts';
import MachineSlider from '../components/MachineSlider.astro';
---
<Layout><section class="hero shell"><div class="hero-content"><p class="eyebrow">SEGURIDAD · NOTAS DE CAMPO</p><h1><Typewriter lines={['El camino también','merece documentarse.']} /></h1><p class="lead">Notas de campo sobre ciberseguridad.<br/> Mi proceso, una entrada a la vez.</p><a class="explore" href="#archivo">Explorar el archivo <span>↓</span></a></div></section><MachineSlider posts={posts} /><section class="archive shell" id="archivo"><div class="archive-top"><div><p class="eyebrow">EL ARCHIVO</p><h2>Write-ups</h2></div><label class="search" hidden={posts.length===0}><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="Buscar una máquina…" aria-label="Buscar una máquina"/><kbd>/</kbd></label></div><div class="filter-bar" hidden={posts.length===0}><div role="group" aria-label="Dificultad"><button class="selected" data-filter="Todas" aria-pressed="true">Todas</button><button data-filter="Fácil" aria-pressed="false">Fácil</button><button data-filter="Media" aria-pressed="false">Media</button><button data-filter="Difícil" aria-pressed="false">Difícil</button></div>{posts.some(p=>p.frontmatter.demo) && <span class="example">Incluye entradas de ejemplo</span>}</div><div class="entries">{posts.map(({frontmatter:m,cover})=><a class="entry" href={withBase('/writeups/'+m.slug+'/')} data-difficulty={m.difficulty} data-search={[m.title,m.platform,m.os,...m.tags].join(' ').toLowerCase()}><div class="entry-main"><span class="entry-icon" aria-hidden="true">{cover && <img src={cover} alt="" loading="lazy" />}<span hidden={!!cover}>{m.os==='Linux'?'◈':'⊞'}</span></span><div><h3>{m.title}</h3><p>{m.platform}<span> / </span>{m.os}</p></div></div><span class="entry-summary">{m.summary}</span><span class="level">{m.difficulty}</span><span class="entry-arrow" aria-hidden="true">↗</span></a>)}</div><p id="empty" hidden={posts.length>0}>{posts.length ? 'No hay máquinas que coincidan con tu búsqueda.' : 'Todavía no hay write-ups publicados. Las próximas máquinas aparecerán aquí.'}</p><p class="archive-note">Un espacio para entender el proceso, más allá de la solución.</p></section></Layout>
<script>
let current='Todas'; const input=document.querySelector<HTMLInputElement>('#search')!;const rows=[...document.querySelectorAll<HTMLElement>('.entry')];function update(){let visible=0;rows.forEach(row=>{row.hidden=!(current==='Todas'||row.dataset.difficulty===current)||!row.dataset.search!.includes(input.value.toLowerCase().trim());if(!row.hidden)visible++});document.querySelector<HTMLElement>('#empty')!.hidden=visible>0}input.addEventListener('input',update);document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>button.addEventListener('click',()=>{current=button.dataset.filter!;document.querySelectorAll('[data-filter]').forEach(b=>{b.classList.toggle('selected',b===button);b.setAttribute('aria-pressed',String(b===button))});update()}));document.addEventListener('keydown',e=>{if(e.key==='/'&&!(e.target instanceof HTMLInputElement)){e.preventDefault();input.focus()}});
</script>
