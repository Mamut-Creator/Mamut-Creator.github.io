---
import Layout from '../../layouts/Layout.astro';
import { posts } from '../../lib/posts';
import { site } from '../../lib/site';
import ImageViewer from '../../components/ImageViewer.astro';
export function getStaticPaths(){return posts.map(post=>({params:{slug:post.frontmatter.slug},props:{post}}))}
const {post}=Astro.props;const {Content,frontmatter:m,getHeadings}=post;const headings=getHeadings();
---
<Layout title={m.title+' — Bitácora'} description={m.summary}><article class="article shell"><a class="back" href="/#archivo">← Volver al archivo</a><div class="article-heading"><p class="eyebrow">{m.platform} / {m.os} / {m.difficulty}</p><div class="machine-title">{post.cover && <a href={m.machineUrl || '#contenido'} aria-label={m.machineUrl ? 'Abrir máquina en '+m.platform : 'Leer '+m.title} target={m.machineUrl ? '_blank' : undefined} rel={m.machineUrl ? 'noopener noreferrer' : undefined}><img src={post.cover} alt={'Portada de '+m.title} width="100" height="100" /></a>}<h1>{m.title}</h1></div>{m.machineUrl && <a class="platform-link" href={m.machineUrl} target="_blank" rel="noopener noreferrer">Abrir en {m.platform} ↗</a>}<p class="lead">{m.summary}</p><p class="article-author">Por {site.author}</p>{m.demo && <span class="example">Entrada de ejemplo · contenido ilustrativo</span>}</div><div class="reading-layout"><aside><span class="eyebrow">EN ESTA ENTRADA</span>{headings.filter((h:any)=>h.depth===2).map((h:any)=><a href={'#'+h.slug}>{h.text}</a>)}</aside><div class="prose" id="contenido"><Content/></div></div></article><ImageViewer/></Layout>
