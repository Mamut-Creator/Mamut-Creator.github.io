---
import Layout from '../../layouts/Layout.astro';
export async function getStaticPaths(){const posts=Object.values(import.meta.glob('../../content/writeups/*.md',{eager:true})) as any[];return posts.map(post=>({params:{slug:post.frontmatter.slug},props:{post}}))}
const {post}=Astro.props;const {Content,frontmatter:m,getHeadings}=post;const headings=getHeadings();
---
<Layout title={m.title+' — Bitácora'} description={m.summary}><article class="article shell"><a class="back" href="/#archivo">← Volver al archivo</a><div class="article-heading"><p class="eyebrow">{m.platform} / {m.os} / {m.difficulty}</p><h1>{m.title}</h1><p class="lead">{m.summary}</p><span class="example">Entrada de ejemplo · contenido ilustrativo</span></div><div class="reading-layout"><aside><span class="eyebrow">EN ESTA ENTRADA</span>{headings.filter((h:any)=>h.depth===2).map((h:any)=><a href={'#'+h.slug}>{h.text}</a>)}</aside><div class="prose"><Content/></div></div></article></Layout>
